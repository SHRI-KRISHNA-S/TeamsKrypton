datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  CLUB_PRESIDENT
  FACULTY_COORDINATOR
  COLLEGE_ADMIN
  SUPER_ADMIN
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClubRole {
  MEMBER
  OFFICER
  PRESIDENT
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
}

enum AttendanceMethod {
  QR
  MANUAL
}

enum OpportunityType {
  HACKATHON
  COMPETITION
  INTERNSHIP
  RECRUITMENT
  SCHOLARSHIP
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
}

enum NotificationType {
  ANNOUNCEMENT
  EVENT_REMINDER
  MEMBERSHIP_UPDATE
  OPPORTUNITY_UPDATE
}

model User {
  id                    String                   @id @default(uuid())
  email                 String                   @unique
  password              String
  name                  String
  department            String
  role                  Role                     @default(STUDENT)
  isVerified            Boolean                  @default(false)
  verificationToken     String?
  passwordResetToken    String?
  passwordResetExpires  DateTime?
  skills                String[]                 @default([])
  bio                   String?
  avatar                String?
  totalAp               Int                      @default(0)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  refreshTokens         RefreshToken[]
  memberships           Membership[]
  registrations         EventRegistration[]
  attendanceRecords     Attendance[]
  feedbacks             Feedback[]
  uploadedMedia         GalleryItem[]
  posts                 Post[]
  comments              Comment[]
  likes                 PostLike[]
  bookmarks             Bookmark[]
  opportunities         Opportunity[]
  applications          OpportunityApplication[]
  notifications         Notification[]
  projects              Project[]
  achievements          Achievement[]
  certificates          Certificate[]
  auditLogs             AuditLog[]
  activityTransactions  ActivityTransaction[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Club {
  id          String        @id @default(uuid())
  name        String        @unique
  description String
  category    String
  logo        String?
  banner      String?
  isApproved  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  memberships Membership[]
  events      Event[]
  gallery     GalleryItem[]
  posts       Post[]

  @@map("clubs")
}

model Membership {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId    String
  club      Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  status    MembershipStatus @default(PENDING)
  role      ClubRole         @default(MEMBER)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, clubId])
  @@map("memberships")
}

model Event {
  id            String              @id @default(uuid())
  title         String
  description   String
  date          DateTime
  venue         String
  capacity      Int
  isApproved    Boolean             @default(false)
  clubId        String
  club          Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  registrations EventRegistration[]
  attendance    Attendance[]
  feedback      Feedback[]
  gallery       GalleryItem[]

  @@map("events")
}

model EventRegistration {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status    RegistrationStatus @default(REGISTERED)
  attended  Boolean            @default(false)
  createdAt DateTime           @default(now())

  @@unique([userId, eventId])
  @@map("event_registrations")
}

model Attendance {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  method    AttendanceMethod
  markedBy  String
  timestamp DateTime         @default(now())

  @@map("attendance_records")
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rating    Int
  comments  String?
  createdAt DateTime @default(now())

  @@map("feedbacks")
}

model GalleryItem {
  id        String   @id @default(uuid())
  url       String
  clubId    String?
  club      Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("gallery_items")
}

model Post {
  id        String     @id @default(uuid())
  title     String?
  content   String
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  clubId    String?
  club      Club?      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  comments  Comment[]
  likes     PostLike[]
  bookmarks Bookmark[]

  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comments")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@map("post_likes")
}

model Bookmark {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@map("bookmarks")
}

model Opportunity {
  id           String                   @id @default(uuid())
  title        String
  description  String
  type         OpportunityType
  company      String?
  deadline     DateTime
  location     String?
  requirements String?
  link         String?
  postedById   String
  postedBy     User                     @relation(fields: [postedById], references: [id], onDelete: Cascade)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  applications OpportunityApplication[]

  @@map("opportunities")
}

model OpportunityApplication {
  id            String            @id @default(uuid())
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeUrl     String?
  status        ApplicationStatus @default(PENDING)
  createdAt     DateTime          @default(now())

  @@unique([opportunityId, userId])
  @@map("opportunity_applications")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}

model ActivityTransaction {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityType String
  points       Int
  description  String
  referenceId  String?
  createdBy    String
  createdAt    DateTime @default(now())

  @@map("activity_transactions")
}

model Certificate {
  id        String   @id @default(uuid())
  uniqueId  String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  issuedBy  String
  issueDate DateTime
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("certificates")
}

model Project {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  link        String?
  createdAt   DateTime @default(now())

  @@map("projects")
}

model Achievement {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  date        DateTime
  createdAt   DateTime @default(now())

  @@map("achievements")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model GlobalSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("global_settings")
}
